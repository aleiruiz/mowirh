NODE_ENV=development
PORT=4000
# The app connects as the restricted role; migrations use DATABASE_OWNER_URL.
# docker-compose's Postgres trusts local connections, so these URLs carry no password.
DATABASE_URL=postgres://mowihr_app@localhost:5432/mowihr
DATABASE_OWNER_URL=postgres://mowihr_owner@localhost:5432/mowihr
# Optional, local only: a password for mowihr_app if your Postgres requires one.
# DATABASE_APP_PASSWORD=
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_WORKSPACE_DOMAIN=mowiapp.com
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12
# Only honoured when NODE_ENV is development or test.
DEV_LOGIN_ENABLED=true
TRUST_PROXY_HOPS=0
# Seeded as the first super admin by `pnpm db:seed`.
SEED_SUPERADMIN_EMAIL=ceo@mowiapp.com
SEED_SUPERADMIN_NAME=CEO
