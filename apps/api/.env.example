NODE_ENV=development
PORT=4000
# The app connects as the restricted role; migrations use DATABASE_OWNER_URL.
DATABASE_URL=postgres://mowihr_app:mowihr_app@localhost:5432/mowihr
DATABASE_OWNER_URL=postgres://mowihr_owner:mowihr_owner@localhost:5432/mowihr
# Password given to mowihr_app by `pnpm db:migrate` when the role has none (local only).
DATABASE_APP_PASSWORD=mowihr_app
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_WORKSPACE_DOMAIN=mowiapp.com
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12
DEV_LOGIN_ENABLED=true
TRUST_PROXY_HOPS=0
# Seeded as the first super admin by `pnpm db:seed`.
SEED_SUPERADMIN_EMAIL=ceo@mowiapp.com
SEED_SUPERADMIN_NAME=CEO
